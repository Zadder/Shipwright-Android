static int CVarGetInteger(const char* name, int fallback) {
    return strcmp(name, "gEnhancements.ManualJumpVaultMode") == 0 ? (vaultMode < 0 ? fallback : vaultMode) : enabled;
}
#define COND_VB_SHOULD(id, condition, body) \
    hooks[id] = nullptr; \
    if (condition) { hooks[id] = [](bool* should, va_list args) { body; }; }
struct RegisterShipInitFunc {
    RegisterShipInitFunc(void (*fn)(), const char* const (&)[2]) { fn(); }
};
static bool GameInteractor_Should(int id, uint32_t initial, ...) {
    bool result = initial;
    va_list args;
    va_start(args, initial);
    if (hooks[id]) hooks[id](&result, args);
    va_end(args);
    return result;
}
