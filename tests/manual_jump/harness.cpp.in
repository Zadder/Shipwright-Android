    *height = 100; return waterDive;
}
static int func_8083A6AC(Player* p, PlayState*) {
    ++ledgeChecks;
    if (catchLedge) { p->stateFlags1 |= PLAYER_STATE1_HANGING_OFF_LEDGE; p->actionFunc = SpecialAction; }
    return catchLedge;
}
static void Player_AnimPlayLoop(PlayState*, Player*, LinkAnimationHeader*) { ++landingAnimations; }
