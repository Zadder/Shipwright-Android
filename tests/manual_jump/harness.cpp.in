@MODULE@
static Player p;
static PlayState play;
static Input inputState;
static void Reset() {
    p = Player{}; p.ageProperties = &p.age; p.actionFunc = Player_Action_Idle;
    play = PlayState{}; play.player = &p;
    inputState = Input{}; inputState.press.button = BTN_CUSTOM_JUMP;
    sControlInput = &inputState;
    gSaveContext.health = 48;
    targeting = blockingCs = upperBusy = handlerTaken = catchLedge = waterDive = false;
    ledgeChecks = landingAnimations = 0;
    sPrevFloorProperty = 0; sYDistToFloor = 100;
    // Normal boot register values from sBootData, z_player_lib.c.
    regs[66] = 590; regs[67] = 750; regs[68] = 125; regs[69] = 200;
    enabled = 1; vaultMode = 0; ticks = 1000; RegisterManualJump();
}
static bool TryJump() {
    // One negative entry is a complete vanilla action-handler list.
    s8 lastHandler[] = { -1 };
    return Player_TryActionHandlerList(&play, &p, lastHandler, true);
}
static void InputEdges(Input* input) {
    const uint32_t buttonDiff = input->prev.button ^ input->cur.button;
    @EDGES@
}
static void LowObstacle(int delay = 3) {
    p.actionFunc = Player_Action_80842180;
    p.ledgeClimbType = 1; p.ledgeClimbDelayTimer = delay;
    p.actor.bgCheckFlags |= BGCHECKFLAG_PLAYER_WALL_INTERACT;
    p.linearVelocity = 5;
    p.yaw = 0; p.actor.wallYaw = -32768;
}
int main() {
    // An unset vault mode defaults to Manual, while explicit Automatic is respected.
    Reset(); LowObstacle(); vaultMode = -1; inputState.press.button = 0;
    assert(!Player_ActionHandler_12(&p, &play));
    inputState.press.button = BTN_CUSTOM_JUMP;
    assert(TryJump()); assert(p.linearVelocity == 2.5f && p.actor.velocity.y == 7.1f);
    // Automatic and disabled modes preserve the actual vanilla vault.
    Reset(); LowObstacle(); inputState.press.button = 0;
    assert(Player_ActionHandler_12(&p, &play)); assert(p.linearVelocity == 2.5f);
    assert(p.actor.velocity.y == 7.1f);
    Reset(); LowObstacle(); vaultMode = 1; enabled = 0; inputState.press.button = 0;
    assert(Player_ActionHandler_12(&p, &play));
    // Manual mode suppresses movement-only vaults and uses native action/impulse on press.
    Reset(); LowObstacle(); vaultMode = 1; inputState.press.button = 0;
    assert(!Player_ActionHandler_12(&p, &play)); assert(!TryJump());
    inputState.press.button = BTN_CUSTOM_JUMP;
    assert(TryJump()); assert(p.linearVelocity == 2.5f && p.actor.velocity.y == 7.1f);
    assert(!TryJump());
    // A press just before the vanilla timer completes survives for 180 ms.
    Reset(); LowObstacle(1); vaultMode = 1;
    assert(!TryJump()); assert(p.actor.bgCheckFlags & BGCHECKFLAG_GROUND);
    inputState.press.button = 0; ticks += 150; p.ledgeClimbDelayTimer = 3;
    assert(TryJump()); assert(p.linearVelocity == 2.5f);
    // Expiry resolves to an ordinary jump, not a late native vault.
    Reset(); LowObstacle(1); vaultMode = 1; assert(!TryJump());
    inputState.press.button = 0; ticks += 181; p.ledgeClimbDelayTimer = 3;
    assert(TryJump()); assert(p.linearVelocity == 5 && p.actor.velocity.y >= 6);
    // Moving away, standing still and lacking an actual wall never grant manual vault eligibility.
    for (int invalid = 0; invalid < 4; ++invalid) {
        Reset(); LowObstacle(); vaultMode = 1;
        if (invalid == 0) p.linearVelocity = 0;
        if (invalid == 1) p.yaw = -32768;
        if (invalid == 2) p.actor.bgCheckFlags &= ~BGCHECKFLAG_PLAYER_WALL_INTERACT;
        if (invalid == 3) targeting = true;
        assert(!Player_ActionHandler_12(&p, &play));
    }
    // Native short fence step-ups require Jump in Manual, for both native sizes.
    CollisionPoly wall;
    for (int type = 2; type <= 3; ++type) {
        Reset(); LowObstacle(6); vaultMode = 1; p.ledgeClimbType = type;
        p.actor.wallPoly = &wall; p.yDistToLedge = 40; inputState.press.button = 0;
        assert(!Player_ActionHandler_12(&p, &play)); assert(!TryJump());
        inputState.press.button = BTN_CUSTOM_JUMP;
        assert(TryJump()); assert(p.actionFunc == Player_Action_80845668);
        assert(p.stateFlags1 & PLAYER_STATE1_CLIMBING_LEDGE);
        assert(p.actor.world.pos.y == 40 && p.linearVelocity == 5);
        Reset(); LowObstacle(6); p.ledgeClimbType = type; p.actor.wallPoly = &wall;
        inputState.press.button = 0; assert(Player_ActionHandler_12(&p, &play)); // Automatic
        Reset(); LowObstacle(6); vaultMode = 1; enabled = 0;
        p.ledgeClimbType = type; p.actor.wallPoly = &wall; inputState.press.button = 0;
        assert(Player_ActionHandler_12(&p, &play)); // Disabled fallback
    }
    // Explicit A climbing and tall native climbing remain unchanged in Manual.
    Reset(); vaultMode = 1; p.ledgeClimbType = 2; p.actor.wallPoly = &wall;
    inputState.press.button = BTN_A; assert(Player_ActionHandler_12(&p, &play));
    Reset(); vaultMode = 1; p.ledgeClimbType = 4; p.ledgeClimbDelayTimer = 6;
    p.yDistToLedge = 90; inputState.press.button = 0;
    assert(Player_ActionHandler_12(&p, &play)); assert(p.actionFunc == Player_Action_80845668);
    // A Jump pressed shortly before the native step-up timer completes is buffered.
    Reset(); LowObstacle(4); vaultMode = 1; p.ledgeClimbType = 3;
    p.actor.wallPoly = &wall; p.yDistToLedge = 40; assert(!TryJump());
    ticks += 150; p.ledgeClimbDelayTimer = 6; inputState.press.button = 0;
    assert(TryJump()); assert(p.actionFunc == Player_Action_80845668);
    // Swimming exits bypass the short-step gate, even without a Jump press.
    Reset(); vaultMode = 1; p.ledgeClimbType = 2; p.ledgeClimbDelayTimer = 6;
    p.actor.wallPoly = &wall; p.stateFlags1 = PLAYER_STATE1_IN_WATER;
    inputState.press.button = 0; assert(Player_ActionHandler_12(&p, &play));
    // A normal floor/wall with no native low-obstacle classification falls back to normal Jump.
    Reset(); vaultMode = 1; p.linearVelocity = 5; assert(TryJump()); assert(p.linearVelocity == 5);
    // Leaving the obstacle cancels a pending press; held input cannot jump later.
    Reset(); LowObstacle(1); vaultMode = 1; assert(!TryJump());
    p.ledgeClimbType = 0; inputState.press.button = 0; assert(!TryJump());
    LowObstacle(); assert(!TryJump());
    Reset(); LowObstacle(1); vaultMode = 1; ticks = 0xFFFFFFC0u; assert(!TryJump());
    inputState.press.button = 0; ticks += 150; p.ledgeClimbDelayTimer = 3;
    assert(TryJump()); // monotonic clock wraparound
    Reset(); LowObstacle(1); vaultMode = 1; assert(!TryJump());
    play.pauseCtx.state = 1; inputState.press.button = 0; assert(!TryJump());
    play.pauseCtx.state = 0; LowObstacle(); assert(!TryJump());
    Reset(); LowObstacle(1); vaultMode = 1; assert(!TryJump());
    inputState.press.button = 0; enabled = 0; LowObstacle(); assert(Player_ActionHandler_12(&p, &play));
    p.actionFunc = Player_Action_80842180; p.actor.bgCheckFlags |= BGCHECKFLAG_GROUND;
    enabled = 1; assert(!Player_ActionHandler_12(&p, &play));
    const float speeds[] = { 0.0f, 1.0f, 3.0f, 6.0f };
    for (float speed : speeds) {
        Reset(); p.actionFunc = speed ? Player_Action_80842180 : Player_Action_Idle;
        p.linearVelocity = speed; p.yaw = p.actor.shape.rot.y = 1234;
        assert(TryJump());
        assert(p.linearVelocity == speed && p.yaw == 1234 && p.actor.shape.rot.y == 1234);
        assert(p.actor.velocity.y >= 6.0f && p.actionFunc == Player_Action_8084411C);
        assert(!(p.actor.bgCheckFlags & 1));
        assert(!TryJump()); // no double jumping, even with the press still present
    }
    Reset(); inputState.press.button = 0; inputState.cur.button = BTN_CUSTOM_JUMP; assert(!TryJump());
    Reset(); enabled = 0; RegisterManualJump(); assert(!TryJump());
    Reset(); p.actionFunc = SpecialAction; assert(!TryJump());
    Reset(); targeting = true; assert(!TryJump());
    Reset(); blockingCs = true; assert(!TryJump());
    Reset(); play.csCtx.state = 1; assert(!TryJump());
    Reset(); play.pauseCtx.state = 1; assert(!TryJump());
    Reset(); p.av2.actionVar2 = 5; assert(!TryJump());
    Reset(); p.itemAction = 1; assert(!TryJump());
    Reset(); p.meleeWeaponState = 1; assert(!TryJump());
    Reset(); p.actor.bgCheckFlags = 0; assert(!TryJump());
    Reset(); gSaveContext.health = 0; assert(!TryJump());
    Reset(); upperBusy = true; assert(!TryJump());
    Reset(); handlerTaken = true; assert(TryJump()); assert(p.actionFunc == Player_Action_Idle);
    const uint32_t excluded[] = { PLAYER_STATE1_IN_WATER, PLAYER_STATE1_HANGING_OFF_LEDGE,
        PLAYER_STATE1_CLIMBING_LEDGE, PLAYER_STATE1_CLIMBING_LADDER, PLAYER_STATE1_CARRYING_ACTOR,
        PLAYER_STATE1_TALKING, PLAYER_STATE1_DAMAGED, PLAYER_STATE1_INPUT_DISABLED,
        PLAYER_STATE1_ON_HORSE, PLAYER_STATE1_IN_CUTSCENE, PLAYER_STATE1_GETTING_ITEM };
    for (auto state : excluded) { Reset(); p.stateFlags1 = state; assert(!TryJump()); }
    const uint32_t excluded2[] = { PLAYER_STATE2_CRAWLING, PLAYER_STATE2_DIVING, PLAYER_STATE2_HOPPING,
        PLAYER_STATE2_FROZEN, PLAYER_STATE2_GRABBED_BY_ENEMY, PLAYER_STATE2_OCARINA_PLAYING };
    for (auto state : excluded2) { Reset(); p.stateFlags2 = state; assert(!TryJump()); }
    for (int mode = 0; mode < 2; ++mode) {
        for (int grab = 0; grab < 2; ++grab) {
            Reset(); enabled = mode; RegisterManualJump(); catchLedge = grab;
            p.actor.bgCheckFlags = 4; p.linearVelocity = 6;
            func_8083AA10(&p, &play);
            assert((p.actor.velocity.y > 0) == !mode);
            assert(ledgeChecks == mode);
            assert(bool(p.stateFlags1 & PLAYER_STATE1_HANGING_OFF_LEDGE) == bool(mode && grab));
            assert(landingAnimations == (mode && !grab));
        }
    }
    Reset(); p.actor.bgCheckFlags = 4; p.linearVelocity = 6;
    sPrevFloorProperty = 11; waterDive = true; func_8083AA10(&p, &play);
    assert(p.actionFunc == Player_Action_80844A44 && p.actor.velocity.y == 6 && ledgeChecks == 0);
    Reset(); func_8083A4A8(&p, &play); assert(p.actor.velocity.y == 1.25f); // untouched vanilla call
    Input edge{}; edge.cur.button = BTN_CUSTOM_JUMP | 0x8000;
    InputEdges(&edge); assert(edge.press.button == edge.cur.button);
    edge.prev = edge.cur; edge.press.button = 0; InputEdges(&edge); assert(edge.press.button == 0);
    edge.cur.button = 0; InputEdges(&edge); assert(edge.rel.button == (BTN_CUSTOM_JUMP | 0x8000));
    puts("PASS: manual jump policy, stationary/moving impulses, no repeat/double jump, ledge fall/grab,");
    puts("      disabled vanilla behavior, special water dive and 32-bit press/release edges.");
    puts("      native vaults/short step-ups, priority, 180 ms buffer, cancellation and preserved tall/A/water climbing.");
}
